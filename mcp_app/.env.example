# OpenReplay MCP App Configuration
# Copy this file to .env and fill in your value.

# Your OpenReplay instance URL — the address you visit in your browser.
# SaaS: https://app.openreplay.com   Self-hosted: https://openreplay.your-company.com
# The API host is derived from this automatically.
OPENREPLAY_URL=https://app.openreplay.com
